TestAudio/

# Generated transcripts (output artifacts from FullClipTranscriptionTests)
TranscriptOutput/

# Test audio (provide your own)
Samples/**/*.wav
Samples/**/*.m4a
Samples/**/*.flac

# Python
__pycache__/
*.pyc
.venv/
